MYSQL_DATABASE=revival
MYSQL_ROOT_USER=root
MYSQL_USER=revival

API_KEYCLOAK_REALM=fgv
API_KEYCLOAK_ADMIN_CLIENT_ID=fgv-admin
API_KEYCLOAK_CLIENT_CLIENT_ID=fgv-revival
