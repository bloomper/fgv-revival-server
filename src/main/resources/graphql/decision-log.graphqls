# A revival's decision log. There is no delete mutation.

extend type Query {
    "The revival's rows matching every given filter, by number. Readers of the revival."
    logEntries(revivalId: ID!, filter: LogEntryFilter): [LogEntry!]!

    "NOT_FOUND unless the caller can read the row's revival."
    logEntry(id: ID!): LogEntry

    "Distinct tags in the revival's log, for reuse."
    logTags(revivalId: ID!): [String!]!
}

extend type Mutation {
    "Directeur or steering group, revival visible and not ARCHIVED. With meetingId, the row belongs to that meeting."
    logEntryCreate(input: LogEntryCreateInput!): LogEntry!

    "As logEntryCreate. Any field but the number."
    logEntryUpdate(input: LogEntryUpdateInput!): LogEntry!

    "Creates a DECISION answering an open QUESTION, and sets the question to DONE."
    logEntryAnswer(input: LogEntryAnswerInput!): LogEntryAnswerPayload!
}

enum LogEntryType {
    DECISION
    TODO
    QUESTION
}

enum LogEntryStatus {
    OPEN
    DONE
    WAITING
    CANCELLED
}

enum LogEntryOrigin {
    MANUAL
    IMPORT
    GUIDE
}

type LogEntry {
    id: ID!
    revivalId: ID!
    number: Int!
    date: Date!
    type: LogEntryType!
    text: String!
    status: LogEntryStatus!
    owner: Owner
    deadline: Date
    "OPEN or WAITING with a deadline before today, Europe/Stockholm."
    overdue: Boolean!
    comment: String
    tags: [String!]!
    meeting: MeetingSummary
    "The guide item, in the revival's pinned version, if it is still there."
    guideItem: GuideItem
    guideItemKey: ID
    checklistItem: ChecklistItemSummary
    "An event of the revival, cancelled or not."
    event: Event
    """
    On a DECISION: the budget lines that refer to it, not removed. Null unless the caller reads the revival's budget.
    """
    budgetLines: [BudgetLine!]
    "On a DECISION: the question it answers."
    answers: LogEntrySummary
    "On a QUESTION: the decision answering it."
    answeredBy: LogEntrySummary
    origin: LogEntryOrigin!
    "Display name."
    createdBy: String
    createdAt: Instant!
    "Display name."
    lastModifiedBy: String
    lastModifiedAt: Instant
    version: Int!
}

type LogEntrySummary {
    id: ID!
    number: Int!
    type: LogEntryType!
    status: LogEntryStatus!
}

input LogEntryFilter {
    "Rows whose owner is the caller."
    mine: Boolean = false
    "OPEN or WAITING."
    open: Boolean = false
    overdue: Boolean = false
    "Any of these."
    types: [LogEntryType!]
    meetingId: ID
    "Any of these."
    tags: [String!]
    "Matches text, comment and free-text owner, ignoring case and diacritics."
    text: String
}

input LogEntryCreateInput {
    revivalId: ID!
    "A meeting IN_PROGRESS in the same revival."
    meetingId: ID
    "Defaults to today."
    date: Date
    type: LogEntryType!
    text: String!
    "Defaults to OPEN."
    status: LogEntryStatus
    owner: OwnerInput
    deadline: Date
    comment: String
    tags: [String!]
    guideItemKey: ID
    checklistItemId: ID
    "An event of the same revival."
    eventId: ID
}

"Fields left out are unchanged. The clear* flags remove a value."
input LogEntryUpdateInput {
    id: ID!
    version: Int!
    meetingId: ID
    date: Date
    type: LogEntryType
    text: String
    status: LogEntryStatus
    owner: OwnerInput
    clearOwner: Boolean = false
    deadline: Date
    clearDeadline: Boolean = false
    comment: String
    clearComment: Boolean = false
    "Replaces the tags."
    tags: [String!]
    guideItemKey: ID
    checklistItemId: ID
    eventId: ID
    "Removes the event link only."
    clearEvent: Boolean = false
    "Removes the guide item, checklist item and event links, before any given ones are set."
    clearLinks: Boolean = false
}

input LogEntryAnswerInput {
    questionId: ID!
    questionVersion: Int!
    meetingId: ID
    text: String!
    owner: OwnerInput
    deadline: Date
    comment: String
}

type LogEntryAnswerPayload {
    question: LogEntry!
    decision: LogEntry!
}
