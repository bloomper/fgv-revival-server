# Chapter and event checklists. There is no delete mutation.

enum ChecklistItemState {
    OPEN
    DONE
    NOT_APPLICABLE
}

type ChecklistItemSummary {
    id: ID!
    checklistId: ID!
    text: LocalizedText!
    state: ChecklistItemState!
}

extend type Query {
    "One checklist per chapter of the pinned guide version, in the guide's order, then event checklists by date. Readers of the revival."
    checklists(revivalId: ID!, includeCancelled: Boolean = false): [ChecklistSummary!]!
    "NOT_FOUND unless the caller can read the checklist's revival."
    checklist(id: ID!): Checklist
    "Items across the revival's checklists matching every given filter."
    checklistItems(revivalId: ID!, filter: ChecklistItemFilter): [ChecklistItem!]!
    """
    What removing the chapter from the guide would delete, over revivals that are not archived, once they move to a
    version without it. An upper bound: required items follow their requirement if it moves to another chapter first.
    SUPER_ADMIN.
    """
    guideChapterRemovalImpact(chapterKey: ID!): GuideChapterRemovalImpact!
}

extend type Revival {
    "The chapter checklists that moving to the version would delete. Readers of the revival."
    guideVersionChangeImpact(toId: ID!): [ChecklistRemoval!]!
}

type GuideChapterRemovalImpact {
    chapterKey: ID!
    "Revivals with a checklist for the chapter."
    revivalCount: Int!
    itemCount: Int!
    doneCount: Int!
}

"A chapter checklist that a change of guide version would delete, with the items that would go with it."
type ChecklistRemoval {
    checklistId: ID!
    chapterKey: ID!
    "In the revival's current version."
    chapterTitle: LocalizedText
    "Required items whose requirement moves to another chapter are not counted: they move along."
    itemCount: Int!
    doneCount: Int!
    "Log rows linked to those items. They stay, without the link."
    linkedLogEntryCount: Int!
}

extend type Mutation {
    "Directeur or steering group, revival visible and not ARCHIVED, for every checklist mutation unless noted."
    eventChecklistCreate(input: EventChecklistCreateInput!): Checklist!
    "Name and date. Changing the date recomputes deadlines that were not set by hand."
    eventChecklistUpdate(input: EventChecklistUpdateInput!): Checklist!
    eventChecklistCancel(id: ID!, version: Int!): Checklist!
    "Adds the template's items not already in the checklist. Returns the checklist."
    checklistAddFromTemplate(input: ChecklistAddFromTemplateInput!): Checklist!

    checklistItemCreate(input: ChecklistItemCreateInput!): ChecklistItem!
    "Text is refused on required items."
    checklistItemUpdate(input: ChecklistItemUpdateInput!): ChecklistItem!
    "DONE, OPEN (reopen) or NOT_APPLICABLE. NOT_APPLICABLE on a required item: directeur only, reason required."
    checklistItemSetState(input: ChecklistItemSetStateInput!): ChecklistItem!
}

enum ChecklistKind {
    CHAPTER
    EVENT
}

type ChecklistSummary {
    id: ID!
    kind: ChecklistKind!
    chapterKey: ID
    "CHAPTER: the chapter's title in the pinned version."
    chapterTitle: LocalizedText
    name: String
    date: Date
    cancelled: Boolean!
    openCount: Int!
    overdueCount: Int!
    totalCount: Int!
}

type Checklist {
    id: ID!
    revivalId: ID!
    kind: ChecklistKind!
    "CHAPTER: the chapter's key."
    chapterKey: ID
    "CHAPTER: the chapter's title in the pinned version."
    chapterTitle: LocalizedText
    "EVENT."
    name: String
    date: Date
    template: ChecklistTemplateSummary
    cancelled: Boolean!
    items: [ChecklistItem!]!
    "CHAPTER: the chapter's TIP items in the pinned version."
    tips: [GuideItem!]!
    "Templates the caller may add items from."
    templatesAvailable: [ChecklistTemplateSummary!]!
    version: Int!
}

type ChecklistItem {
    id: ID!
    checklist: ChecklistSummary!
    required: Boolean!
    "Required items: the guide item's text in the pinned version. Others: the item's text."
    text: LocalizedText!
    state: ChecklistItemState!
    stateChangedBy: PersonRef
    stateChangedAt: Instant
    "The person's reason, or the sync's reason rendered in the reader's language."
    reason: String
    owner: Owner
    deadline: Date
    deadlineManual: Boolean!
    "OPEN with a deadline before today."
    overdue: Boolean!
    comment: String
    "Linked guide item, in the pinned version, if it is still there."
    guideItem: GuideItem
    guideItemKey: ID
    "A capability hint from the template while the item has no owner."
    defaultCapability: Capability
    "Log rows linked to this item."
    logEntries: [LogEntrySummary!]!
    version: Int!
}

input ChecklistItemFilter {
    mine: Boolean = false
    open: Boolean = false
    overdue: Boolean = false
    checklistId: ID
    requiredOnly: Boolean = false
}

input EventChecklistCreateInput {
    revivalId: ID!
    name: String!
    date: Date
    "An EVENT template that is not retired. Without it, the checklist starts empty."
    templateId: ID
}

input EventChecklistUpdateInput {
    id: ID!
    version: Int!
    name: String
    date: Date
    clearDate: Boolean = false
}

input ChecklistAddFromTemplateInput {
    checklistId: ID!
    version: Int!
    "CHAPTER: the chapter's template (default). EVENT: any EVENT template not retired."
    templateId: ID
}

input ChecklistItemCreateInput {
    checklistId: ID!
    text: String!
    owner: OwnerInput
    deadline: Date
    comment: String
    guideItemKey: ID
}

input ChecklistItemUpdateInput {
    id: ID!
    version: Int!
    text: String
    owner: OwnerInput
    clearOwner: Boolean = false
    "Sets deadlineManual."
    deadline: Date
    clearDeadline: Boolean = false
    comment: String
    clearComment: Boolean = false
}

input ChecklistItemSetStateInput {
    id: ID!
    version: Int!
    state: ChecklistItemState!
    reason: String
}
