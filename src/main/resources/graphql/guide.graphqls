extend type Query {
    "Published versions, newest first. Readers of the guide (FR-001–FR-003)."
    guideVersions: [GuideVersionSummary!]!

    "A published version, or the draft for SUPER_ADMIN. Anything else is NOT_FOUND."
    guideVersion(id: ID!): GuideVersion

    "The latest published version, or null before the first is published."
    guideLatestVersion: GuideVersion

    "Search one version (FR-021). Defaults to the latest published version."
    guideSearch(versionId: ID, query: String!, first: Int = 50): [GuideSearchHit!]!

    "The draft, or null when there is none. SUPER_ADMIN."
    guideDraft: GuideDraft

    "What changed between two versions the caller can read (FR-016)."
    guideChanges(fromId: ID!, toId: ID!): GuideChanges!

    "Every signed-in caller. Retired types only with includeRetired."
    guideItemTypes(includeRetired: Boolean = false): [GuideItemType!]!
}

extend type Mutation {
    "SUPER_ADMIN. Publishes the draft as the next version, labelled v1, v2, … (FR-014), and pins revivals without a version (FR-018)."
    guideDraftPublish(input: GuideDraftPublishInput!): GuideVersion!

    "SUPER_ADMIN. Deletes a published version. One that is not deletable is refused: see GuideVersionSummary.deletable."
    guideVersionDelete(id: ID!, version: Int!): Void

    "SUPER_ADMIN. Deletes the draft and reopens suggestions accepted into it (FR-015)."
    guideDraftDiscard(id: ID!, version: Int!): Void

    "SUPER_ADMIN. Copies the latest published version, or creates an empty draft, without chapters, before the first is published."
    guideDraftStart: GuideDraft!

    "SUPER_ADMIN, draft only, for the rest of this block."
    guideIntroductionUpdate(input: GuideIntroductionInput!): GuideVersion!
    "Adds a chapter with a new key."
    guideChapterCreate(input: GuideChapterCreateInput!): GuideChapter!
    guideChapterUpdate(input: GuideChapterInput!): GuideChapter!
    "Returns the draft with its chapters in their new order."
    guideChapterMove(input: GuideChapterMoveInput!): GuideVersion!
    """
    Removes the chapter with its sections and items. Revivals that move to a version without it lose their checklist
    for it: see guideChapterRemovalImpact.
    """
    guideChapterRemove(id: ID!, version: Int!): Void
    guideSectionCreate(input: GuideSectionCreateInput!): GuideSection!
    guideSectionUpdate(input: GuideSectionUpdateInput!): GuideSection!
    guideSectionMove(input: GuideSectionMoveInput!): GuideChapter!
    "Refused while the section has items."
    guideSectionRemove(id: ID!, version: Int!): Void
    guideItemCreate(input: GuideItemCreateInput!): GuideItem!
    guideItemUpdate(input: GuideItemUpdateInput!): GuideItem!
    guideItemMove(input: GuideItemMoveInput!): GuideChapter!
    guideItemRemove(id: ID!, version: Int!): Void

    "SUPER_ADMIN, for every item type mutation. Appends a new type; its kind never changes."
    guideItemTypeCreate(input: GuideItemTypeCreateInput!): GuideItemType!
    "Renaming changes the label in every version, published ones too."
    guideItemTypeUpdate(input: GuideItemTypeUpdateInput!): GuideItemType!
    "Returns every type, retired ones too, in the new order."
    guideItemTypeMove(id: ID!, version: Int!, position: Int!): [GuideItemType!]!
    "A retired type is not offered for new items or suggestions; items that have it keep it."
    guideItemTypeRetire(id: ID!, version: Int!): GuideItemType!
    guideItemTypeRestore(id: ID!, version: Int!): GuideItemType!
    "Refused while any item, in any version, or suggestion has it (inUse): retire it instead."
    guideItemTypeDelete(id: ID!, version: Int!): Void
}

enum GuideVersionStatus {
    DRAFT
    PUBLISHED
}

"""
What the application does with an item of a type (product spec 5.2). Each kind drives behaviour, so the kinds are
fixed while the types are not.
"""
enum GuideItemKind {
    "Shown beside the chapter's checklist."
    TIP
    "Becomes a required item in the chapter's checklist."
    REQUIREMENT
    "Becomes a question in the revival's decision log."
    QUESTION
    "Body text, shown without a type label."
    TEXT
}

"""
What an item is, from the list SUPER_ADMIN keeps. The four the list started with have the ids TIP, REQUIREMENT,
QUESTION and TEXT, each of its own kind; new ones get a UUID.
"""
type GuideItemType {
    id: ID!
    kind: GuideItemKind!
    name: LocalizedText!
    position: Int!
    retired: Boolean!
    "An item in some version, or a suggestion, has it, so it cannot be deleted."
    inUse: Boolean!
    version: Int!
}

input GuideItemTypeCreateInput {
    kind: GuideItemKind!
    "1–100 characters, trimmed; the Swedish name is unique."
    name: LocalizedTextInput!
}

input GuideItemTypeUpdateInput {
    id: ID!
    version: Int!
    name: LocalizedTextInput!
}

"Swedish text, and English when there is one (FR-009a). The client picks by language."
type LocalizedText {
    sv: String!
    en: String
}

type GuideVersionSummary {
    id: ID!
    label: String
    "What changed in this version."
    note: String
    publishedAt: Instant
    "Display name, never an email address."
    publishedBy: String
    "SUPER_ADMIN. Revivals that follow this version now."
    revivalCount: Int!
    "SUPER_ADMIN. Suggestions made on this version."
    suggestionCount: Int!
    "SUPER_ADMIN. Neither followed by a revival nor with suggestions, so it may be deleted."
    deletable: Boolean!
    version: Int!
}

type GuideVersion {
    id: ID!
    status: GuideVersionStatus!
    "Null while DRAFT."
    label: String
    note: String
    "Markdown."
    introduction: LocalizedText!
    chapters: [GuideChapter!]!
    publishedAt: Instant
    "Display name, never an email address."
    publishedBy: String
    basedOn: GuideVersionSummary
    version: Int!
}

type GuideChapter {
    id: ID!
    "Stable across versions."
    key: ID!
    title: LocalizedText!
    "Items before the first section."
    items: [GuideItem!]!
    sections: [GuideSection!]!
    version: Int!
}

type GuideSection {
    id: ID!
    "Stable across versions."
    key: ID!
    title: LocalizedText!
    items: [GuideItem!]!
    version: Int!
}

type GuideItem {
    id: ID!
    "Stable across versions."
    key: ID!
    type: GuideItemType!
    "Markdown."
    text: LocalizedText!
    version: Int!
}

type GuideDraft {
    draft: GuideVersion!
    "Suggestions accepted into this draft; they reopen if it is discarded."
    acceptedSuggestionCount: Int!
    "Introduction, titles and items without English text (FR-009a)."
    untranslatedCount: Int!
}

input GuideDraftPublishInput {
    id: ID!
    version: Int!
    "What changed, optional."
    note: String
}

enum GuideSearchHitKind {
    INTRODUCTION
    CHAPTER_TITLE
    SECTION_TITLE
    ITEM
}

type GuideSearchHit {
    kind: GuideSearchHitKind!
    chapterKey: ID
    chapterTitle: LocalizedText
    sectionKey: ID
    sectionTitle: LocalizedText
    itemKey: ID
    itemType: GuideItemType
    "Plain text around the first match, in the language that matched."
    snippet: String!
    matchedLanguage: String!
}

type GuideChanges {
    from: GuideVersionSummary!
    to: GuideVersionSummary!
    "Languages whose introduction changed."
    introductionChanged: [String!]!
    chapters: [GuideChapterChange!]!
    sections: [GuideSectionChange!]!
    items: [GuideItemChange!]!
}

"A chapter as it is in one of the compared versions."
type GuideChapterRef {
    key: ID!
    title: LocalizedText!
}

type GuideChapterChange {
    key: ID!
    kind: GuideChangeKind!
    "Languages whose title changed."
    renamed: [String!]!
    "In a different place among the chapters both versions have."
    moved: Boolean!
    "Null when ADDED."
    before: LocalizedText
    "Null when REMOVED."
    after: LocalizedText
}

enum GuideChangeKind {
    ADDED
    REMOVED
    CHANGED
}

type GuideSectionChange {
    key: ID!
    kind: GuideChangeKind!
    chapterBefore: GuideChapterRef
    chapterAfter: GuideChapterRef
    "Languages whose title changed."
    renamed: [String!]!
    moved: Boolean!
    "Items it shares with the other version are in a different order."
    reordered: Boolean!
    before: LocalizedText
    after: LocalizedText
}

type GuideItemChange {
    key: ID!
    kind: GuideChangeKind!
    "Languages whose text changed."
    reworded: [String!]!
    retyped: Boolean!
    moved: Boolean!
    before: GuideItemSnapshot
    after: GuideItemSnapshot
}

type GuideItemSnapshot {
    chapter: GuideChapterRef!
    sectionKey: ID
    sectionTitle: LocalizedText
    type: GuideItemType!
    text: LocalizedText!
}

input LocalizedTextInput {
    sv: String!
    "Empty or null clears the English text."
    en: String
}

input GuideIntroductionInput {
    versionId: ID!
    version: Int!
    introduction: LocalizedTextInput!
}

input GuideChapterCreateInput {
    versionId: ID!
    "Null appends."
    position: Int
    title: LocalizedTextInput!
}

input GuideChapterMoveInput {
    id: ID!
    version: Int!
    position: Int!
}

input GuideChapterInput {
    id: ID!
    version: Int!
    title: LocalizedTextInput!
}

input GuideSectionCreateInput {
    chapterId: ID!
    "Null appends."
    position: Int
    title: LocalizedTextInput!
}

input GuideSectionUpdateInput {
    id: ID!
    version: Int!
    title: LocalizedTextInput!
}

input GuideSectionMoveInput {
    id: ID!
    version: Int!
    chapterId: ID!
    position: Int!
}

input GuideItemCreateInput {
    chapterId: ID!
    "Null places it before the chapter's first section."
    sectionId: ID
    "Null appends."
    position: Int
    "A guide item type id, not retired."
    type: ID!
    text: LocalizedTextInput!
}

input GuideItemUpdateInput {
    id: ID!
    version: Int!
    "A guide item type id, not retired unless the item already has it."
    type: ID!
    text: LocalizedTextInput!
}

input GuideItemMoveInput {
    id: ID!
    version: Int!
    chapterId: ID!
    sectionId: ID
    position: Int!
}
