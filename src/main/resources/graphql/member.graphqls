extend type Query {
    "Every signed-in caller. Retired areas only with includeRetired."
    capabilities(includeRetired: Boolean = false): [Capability!]!

    """
    Users in the FGV realm matching the query (name, username or email), for picking a member. SUPER_ADMIN, or a
    directeur of the revival (canManageSteeringGroup). At least 3 characters after trimming, at most 10 results,
    enabled users only. Errors with DIRECTORY_UNAVAILABLE when Keycloak cannot be reached.
    """
    revivalMemberCandidates(revivalId: ID!, query: String!): [MemberCandidate!]!
}

extend type Mutation {
    """
    SUPER_ADMIN adds DIRECTEUR or STEERING_GROUP. Directeur adds STEERING_GROUP. Someone who has not
    logged in with that verified email waits. An email that is not a user in the FGV realm gets one, without any role,
    and Keycloak emails them an invitation (invitedAt); the super admins are emailed when the user lacks the fgv-revival
    USER role. Never fails because Keycloak cannot be reached: the member then waits without an invitation.
    """
    revivalMemberAdd(input: RevivalMemberAddInput!): RevivalMember!

    "Sets the capabilities of a STEERING_GROUP member. SUPER_ADMIN or directeur."
    revivalMemberCapabilitiesSet(input: RevivalMemberCapabilitiesInput!): RevivalMember!

    """
    Removes a member: closes the row and clears its pending email; nothing is deleted.
    SUPER_ADMIN: any member. Directeur: STEERING_GROUP members only.
    """
    revivalMemberRemove(id: ID!): Void

    "SUPER_ADMIN, for every capability mutation. Appends a new area of responsibility."
    capabilityCreate(input: CapabilityCreateInput!): Capability!
    capabilityUpdate(input: CapabilityUpdateInput!): Capability!
    "Returns every capability, retired ones too, in the new order."
    capabilityMove(id: ID!, version: Int!, position: Int!): [Capability!]!
    "A retired capability is not offered for new use; members and items that hold it keep it."
    capabilityRetire(id: ID!, version: Int!): Capability!
    capabilityRestore(id: ID!, version: Int!): Capability!
    "Refused while anything holds it (inUse): retire it instead."
    capabilityDelete(id: ID!, version: Int!): Void
}

enum RevivalRole {
    DIRECTEUR
    STEERING_GROUP
    PARTICIPANT
    HELPER
}

"""
An area of responsibility a steering group member can hold, from the list SUPER_ADMIN keeps. The four the
list started with have the ids FINANCE, CATERING, STAFFING and COMMS; new ones get a UUID.
"""
type Capability {
    id: ID!
    name: LocalizedText!
    position: Int!
    retired: Boolean!
    "A member, checklist item or template item holds it, so it cannot be deleted."
    inUse: Boolean!
    version: Int!
}

input CapabilityCreateInput {
    "1–100 characters, trimmed; the Swedish name is unique."
    name: LocalizedTextInput!
}

input CapabilityUpdateInput {
    id: ID!
    version: Int!
    name: LocalizedTextInput!
}

enum MemberState {
    WAITING
    ACTIVE
}

type RevivalMember {
    id: ID!
    role: RevivalRole!
    capabilities: [Capability!]!
    state: MemberState!
    "Null while WAITING."
    displayName: String
    "Shown only to SUPER_ADMIN and the revival's directeurs; null for everyone else."
    email: Email
    "When this application created a Keycloak user for the member and emailed them; null otherwise."
    invitedAt: Instant
    version: Int!
}

"A user in the FGV realm who can be added as a member."
type MemberCandidate {
    email: Email!
    "First and last name from Keycloak, or null."
    displayName: String
    "Holds the fgv-revival USER role, so they can log in now."
    hasAccess: Boolean!
}

input RevivalMemberAddInput {
    revivalId: ID!
    email: Email!
    role: RevivalRole!
    "Capability ids, none retired."
    capabilities: [ID!] = []
    "Used only when the email is not a Keycloak user and one is created. Trimmed, at most 100 characters."
    firstName: String
    lastName: String
}

input RevivalMemberCapabilitiesInput {
    id: ID!
    version: Int!
    "Capability ids. A retired one may stay if the member already holds it."
    capabilities: [ID!]!
}

"A member of the revival or a free-text name. Exactly one of person or name is set."
type Owner {
    "A directeur or steering group member, or on a checklist item a participant, by display name only."
    person: OwnerPerson
    "A free-text name for someone outside the steering group."
    name: String
}

type OwnerPerson {
    id: ID!
    displayName: String
    "False when the person no longer holds a revival role (counts as no owner)."
    active: Boolean!
}

"Set one of the two, or neither to clear the owner. Both is BAD_REQUEST."
input OwnerInput {
    personId: ID
    "1–100 characters, trimmed."
    name: String
}

"A person shown by display name, never by email address."
type PersonRef {
    id: ID!
    displayName: String
}

extend type Revival {
    """
    Active directeurs and steering group members, who can own rows and checklist items. With includeParticipants, then
    the participants who have logged in, who can own checklist items only.
    """
    ownerCandidates(includeParticipants: Boolean = false): [PersonRef!]!
}
