# The scheduled maintenance jobs, which SUPER_ADMIN can also start by hand.

extend type Query {
    "SUPER_ADMIN. The maintenance jobs, with their schedules and how their latest runs went."
    maintenanceJobs: [MaintenanceJobStatus!]!
}

extend type Mutation {
    "SUPER_ADMIN. Starts the job in the background, as its schedule would. False when it is already running."
    maintenanceJobRun(job: MaintenanceJob!): Boolean!
}

"""
A scheduled maintenance job: deleting participants' data that is no longer needed and anonymizing old revivals
(PARTICIPANT_RETENTION), and reminding owners of planned mailings that are due (MAILING_REMINDERS).
"""
enum MaintenanceJob {
    PARTICIPANT_RETENTION
    MAILING_REMINDERS
}

"A maintenance job and how its latest run went. Runs are remembered until the server restarts."
type MaintenanceJobStatus {
    job: MaintenanceJob!
    "The job's cron expression, in the server's time zone, or null when it is not scheduled."
    schedule: String
    running: Boolean!
    "When the latest run started, or null when it has not run since the server started."
    lastStartedAt: Instant
    lastFinishedAt: Instant
    "Whether the latest run finished without an error; null while it runs."
    lastSucceeded: Boolean
}
