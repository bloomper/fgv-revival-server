extend type Query {
    "Revivals the caller can see (FR-015), newest premiere first, then year descending."
    revivals(status: [RevivalStatus!]): [Revival!]!

    "A revival the caller can see. Not visible and not found both return null with NOT_FOUND (FR-017)."
    revival(id: ID!): Revival
}

extend type Mutation {
    "SUPER_ADMIN. Creates a revival in PROPOSED (FR-006)."
    revivalCreate(input: RevivalCreateInput!): Revival!

    "SUPER_ADMIN: every field. Directeur: premiereDate, showDates, venues (FR-009). Refused while ARCHIVED."
    revivalUpdate(input: RevivalUpdateInput!): Revival!

    "Changes status. SUPER_ADMIN: any. Directeur: next step only (FR-013, FR-014)."
    revivalStatusChange(input: RevivalStatusChangeInput!): Revival!

    "SUPER_ADMIN. Removes the revival with everything that belongs to it (constitution IV). Returns its id."
    revivalDelete(id: ID!, version: Int!): ID!
}

enum RevivalStatus {
    PROPOSED
    APPROVED
    ORGANISING
    OPEN
    CLOSING
    SETTLING
    ARCHIVED
    REJECTED
}

type Revival {
    id: ID!
    spex: Spex!
    year: Year!
    "The spex's title and the year, e.g. \"Ali Baba 2028\", or a generic name while Spexregister is unavailable."
    title: String!
    premiereDate: Date
    showDates: [Date!]!
    venues: [String!]!
    status: RevivalStatus!
    "The pinned guide version. Null only before the first version is published (FR-017)."
    guideVersion: GuideVersionSummary
    "The latest published version when it is newer than guideVersion, otherwise null (FR-019)."
    newerGuideVersion: GuideVersionSummary
    "Newest first."
    guideVersionHistory: [RevivalGuideVersionChange!]!
    "Directeurs and steering group, without removed members. Visible to everyone who can see the revival."
    members: [RevivalMember!]!
    "Newest first."
    statusHistory: [RevivalStatusChange!]!
    "What the caller may do, computed by the server's AccessPolicy."
    permissions: RevivalPermissions!
    version: Int!
    "Display name of the person, resolved from the stored Keycloak subject. Never an email address."
    createdBy: String!
    createdAt: Instant!
    "Display name, as createdBy."
    lastModifiedBy: String
    lastModifiedAt: Instant
}

type RevivalPermissions {
    canEditCore: Boolean!
    canEditDetails: Boolean!
    allowedStatuses: [RevivalStatus!]!
    canManageDirecteurs: Boolean!
    canManageSteeringGroup: Boolean!
    "Directeur or steering group of the revival, visible, not ARCHIVED (FR-031)."
    canSuggestGuideChange: Boolean!
    "Published versions the caller may pin this revival to (FR-020). Empty when they may not change it."
    guideVersionsAllowed: [GuideVersionSummary!]!
    "Directeur or steering group, visible, not ARCHIVED (M3 FR-001)."
    canWriteLog: Boolean!
    "Directeur, visible, not ARCHIVED (M3 FR-025)."
    canWaiveRequirement: Boolean!
    "SUPER_ADMIN (constitution IV)."
    canDelete: Boolean!
}

type RevivalStatusChange {
    from: RevivalStatus!
    to: RevivalStatus!
    "Display name of the person who made the change."
    changedBy: String
    changedAt: Instant!
}

"""
The year must not be before the original spex nor before the current year, and the spex must not already have a
revival that year.
"""
input RevivalCreateInput {
    spexId: ID!
    year: Year!
}

"Omitted fields are left unchanged. Lists replace the whole list."
input RevivalUpdateInput {
    id: ID!
    version: Int!
    spexId: ID
    year: Year
    premiereDate: Date
    clearPremiereDate: Boolean = false
    showDates: [Date!]
    venues: [String!]
}

input RevivalStatusChangeInput {
    id: ID!
    "The status the caller saw; refused with CONFLICT if it has changed."
    from: RevivalStatus!
    to: RevivalStatus!
}

extend type Mutation {
    "SUPER_ADMIN: any published version. Directeur: a newer one (FR-020). Refused while ARCHIVED."
    revivalGuideVersionChange(input: RevivalGuideVersionChangeInput!): Revival!
}

type RevivalGuideVersionChange {
    from: GuideVersionSummary
    to: GuideVersionSummary!
    "Display name of the person who made the change."
    changedBy: String
    changedAt: Instant!
}

input RevivalGuideVersionChangeInput {
    revivalId: ID!
    "The version the caller saw; refused with CONFLICT if it has changed."
    fromVersionId: ID
    toVersionId: ID!
}

"Counts for the revival page (M3)."
type RevivalWorkSummary {
    "Rows OPEN or WAITING."
    openEntries: Int!
    overdueEntries: Int!
    overdueChecklistItems: Int!
    "Open items from the guide's requirements."
    openRequiredItems: Int!
    meetingInProgress: MeetingSummary
}

extend type Revival {
    workSummary: RevivalWorkSummary!
}
