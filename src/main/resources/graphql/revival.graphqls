extend type Query {
    "Revivals the caller can see, newest premiere first, then year descending."
    revivals(status: [RevivalStatus!]): [Revival!]!

    "A revival the caller can see. Not visible and not found both return null with NOT_FOUND."
    revival(id: ID!): Revival
    """
    Everyone with access: the revivals being organised or open whose premiere is set and whose last show has not
    passed, soonest first. Only what a revival announces anyway: proposed, approved and rejected ones are left out.
    """
    upcomingRevivals: [UpcomingRevival!]!
}

extend type Mutation {
    "SUPER_ADMIN. Creates a revival in PROPOSED."
    revivalCreate(input: RevivalCreateInput!): Revival!

    "SUPER_ADMIN: every field. Directeur: premiereDate and shows. Refused while ARCHIVED."
    revivalUpdate(input: RevivalUpdateInput!): Revival!

    "Changes status. SUPER_ADMIN: any. Directeur: next step only."
    revivalStatusChange(input: RevivalStatusChangeInput!): Revival!

    "SUPER_ADMIN. Removes the revival with everything that belongs to it. Returns its id."
    revivalDelete(id: ID!, version: Int!): ID!
}

enum RevivalStatus {
    PROPOSED
    APPROVED
    ORGANISING
    OPEN
    CLOSING
    SETTLING
    ARCHIVED
    REJECTED
}

type Revival {
    id: ID!
    spex: Spex!
    year: Year!
    "The spex's title and the year, e.g. \"Ali Baba 2028\", or a generic name while Spexregister is unavailable."
    title: String!
    premiereDate: Date
    "Ordered by date, then time, then venue, undecided last."
    shows: [RevivalShow!]!
    status: RevivalStatus!
    "The pinned guide version. Null only before the first version is published."
    guideVersion: GuideVersionSummary
    "The latest published version when it is newer than guideVersion, otherwise null."
    newerGuideVersion: GuideVersionSummary
    "Newest first."
    guideVersionHistory: [RevivalGuideVersionChange!]!
    "Directeurs and steering group, without removed members, for readers of the revival's work (permissions.canReadWork); empty for participants and helpers."
    members: [RevivalMember!]!
    "Newest first."
    statusHistory: [RevivalStatusChange!]!
    "What the caller may do, computed by the server's AccessPolicy."
    permissions: RevivalPermissions!
    version: Int!
    "Display name of the person, resolved from the stored Keycloak subject. Never an email address."
    createdBy: String!
    createdAt: Instant!
    "Display name, as createdBy."
    lastModifiedBy: String
    lastModifiedAt: Instant
}

"One show: a date, at a time and a venue."
type RevivalShow {
    date: Date!
    "Start time, HH:mm in Swedish time (Europe/Stockholm), or null when not decided yet."
    time: String
    "Null when not decided yet."
    venue: String
}

type RevivalPermissions {
    canEditCore: Boolean!
    canEditDetails: Boolean!
    allowedStatuses: [RevivalStatus!]!
    canManageDirecteurs: Boolean!
    canManageSteeringGroup: Boolean!
    "Directeur or steering group of the revival, visible, not ARCHIVED."
    canSuggestGuideChange: Boolean!
    "Published versions the caller may pin this revival to. Empty when they may not change it."
    guideVersionsAllowed: [GuideVersionSummary!]!
    "Directeur or steering group, visible, not ARCHIVED."
    canWriteLog: Boolean!
    "Directeur, visible, not ARCHIVED."
    canWaiveRequirement: Boolean!
    "SUPER_ADMIN."
    canDelete: Boolean!
}

type RevivalStatusChange {
    from: RevivalStatus!
    to: RevivalStatus!
    "Display name of the person who made the change."
    changedBy: String
    changedAt: Instant!
}

"""
The year must not be before the original spex nor before the current year, and the spex must not already have a
revival that year.
"""
input RevivalCreateInput {
    spexId: ID!
    year: Year!
}

"Omitted fields are left unchanged. Lists replace the whole list."
input RevivalUpdateInput {
    id: ID!
    version: Int!
    spexId: ID
    year: Year
    premiereDate: Date
    clearPremiereDate: Boolean = false
    """
    Replaces the whole list. Directeur or SUPER_ADMIN, as premiereDate. At most 50 shows, none before the premiere and
    none without one; the same date, time and venue only once.
    """
    shows: [RevivalShowInput!]
}

input RevivalShowInput {
    date: Date!
    "HH:mm, 00:00–23:59. Blank or null when not decided yet."
    time: String
    "Trimmed, at most 255 characters. Blank or null when not decided yet."
    venue: String
}

input RevivalStatusChangeInput {
    id: ID!
    "The status the caller saw; refused with CONFLICT if it has changed."
    from: RevivalStatus!
    to: RevivalStatus!
}

extend type Mutation {
    "SUPER_ADMIN: any published version. Directeur: a newer one. Refused while ARCHIVED."
    revivalGuideVersionChange(input: RevivalGuideVersionChangeInput!): Revival!
}

type RevivalGuideVersionChange {
    "Null when there was none, or the version has since been deleted."
    from: GuideVersionSummary
    "Null when the version has since been deleted."
    to: GuideVersionSummary
    "The labels at the time, kept when a version is deleted."
    fromLabel: String
    toLabel: String!
    "Display name of the person who made the change."
    changedBy: String
    changedAt: Instant!
}

input RevivalGuideVersionChangeInput {
    revivalId: ID!
    "The version the caller saw; refused with CONFLICT if it has changed."
    fromVersionId: ID
    toVersionId: ID!
}

"Counts for the revival page."
type RevivalWorkSummary {
    "Rows OPEN or WAITING."
    openEntries: Int!
    overdueEntries: Int!
    overdueChecklistItems: Int!
    "Open items from the guide's requirements."
    openRequiredItems: Int!
    meetingInProgress: MeetingSummary
}

extend type Revival {
    workSummary: RevivalWorkSummary!
}

"A revival coming up, as it is announced: no people, no work."
type UpcomingRevival {
    id: ID!
    "The spex's title and the year, e.g. \"Ali Baba 2028\"."
    title: String!
    year: Int!
    premiereDate: Date!
    "By date and time."
    shows: [RevivalShow!]!
}
